{
  "name": "csi-mailer",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "prebuild": "bun run clean",
    "predeploy": "bun run build",
    "deploy": "turbo run infra:up",
    "down": "turbo run infra:down",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "init": "turbo run init",
    "plan": "turbo run infra:plan"
  },
  "devDependencies": {
    "prettier": "^3.1.0",
    "turbo": "^2.3.3"
  },
  "packageManager": "bun@1.0.0"
}